const FORMS = {
  base: {
    title: 'Аттестация GENGLASS. Базовый уровень',
    description: '30 вопросов, 25 минут. В каждом вопросе один верный ответ, 1 балл.\n' +
      'Проходной балл: 24 из 30.\n' +
      '6 вопросов критичные: ошибка в любом из них - пересдача независимо от суммы баллов.\n' +
      'Отвечайте по стандарту продаж и CRM GENGLASS.',
    pass: 24
  },
  star: {
    title: 'Аттестация GENGLASS. Вопросы со *',
    description: '15 рабочих ситуаций, 30 минут. В каждой выберите лучший ответ, 2 балла.\n' +
      'Проходной балл: 22 из 30. Сдаётся после базового уровня.\n' +
      'Отвечайте по стандарту продаж и CRM GENGLASS.',
    pass: 22
  }
};

function createAttestationForms() {
  const ss = SpreadsheetApp.create('Аттестация GENGLASS - ответы и итоги');
  const links = [];
  ['base', 'star'].forEach(function (key) {
    const form = buildForm_(key);
    form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());
    SpreadsheetApp.flush();
    const respSheet = findResponseSheet_(ss, form);
    addResultSheet_(ss, respSheet, key);
    links.push(FORMS[key].title + '\n  редактировать: ' + form.getEditUrl() +
               '\n  ссылка для менеджеров: ' + form.getPublishedUrl());
  });
  const def = ss.getSheetByName('Лист1') || ss.getSheetByName('Sheet1');
  if (def && ss.getSheets().length > 1) ss.deleteSheet(def);
  links.push('Таблица ответов и итогов: ' + ss.getUrl());
  Logger.log(links.join('\n\n'));
}

function buildForm_(key) {
  const cfg = FORMS[key];
  const form = FormApp.create(cfg.title);
  form.setDescription(cfg.description)
      .setIsQuiz(true)
      .setShuffleQuestions(true)
      .setProgressBar(true)
      .setAllowResponseEdits(false)
      .setPublishingSummary(false)
      .setLimitOneResponsePerUser(true)
      .setConfirmationMessage('Ответы приняты. Результат откроет РОП после проверки.');
  try {
    form.setEmailCollectionType(FormApp.EmailCollectionType.VERIFIED);
  } catch (e) {
    form.setCollectEmail(true);
  }
  DATA[key].forEach(function (q) {
    const item = form.addMultipleChoiceItem();
    item.setTitle(q.title).setRequired(true).setPoints(q.points);
    if (q.help) item.setHelpText(q.help);
    const opts = shuffle_(q.options.slice());
    item.setChoices(opts.map(function (o) { return item.createChoice(o, o === q.correct); }));
    item.setFeedbackForIncorrect(
      FormApp.createFeedback().setText('Смотрите раздел ' + q.section + ' стандарта.').build());
  });
  return form;
}

function findResponseSheet_(ss, form) {
  const sheets = ss.getSheets();
  for (let i = 0; i < sheets.length; i++) {
    const f = sheets[i].getFormUrl();
    if (f && f.replace(/\/(edit|viewform).*$/, '').indexOf(form.getId()) !== -1) return sheets[i];
  }
  return sheets[sheets.length - 1];
}

function col_(sheetName, header) {
  const s = "'" + sheetName.replace(/'/g, "''") + "'";
  return 'INDEX(' + s + '!A2:ZZ,,MATCH("' + header.replace(/"/g, '""') + '",' + s + '!A1:ZZ1,0))';
}

function addResultSheet_(ss, respSheet, key) {
  const cfg = FORMS[key];
  const name = key === 'base' ? 'Итог базовый' : 'Итог со *';
  const rs = respSheet.getName();
  const sh = ss.insertSheet(name);
  const q = "'" + rs.replace(/'/g, "''") + "'";
  sh.getRange('A1:E1').setValues([['Почта', 'Баллы', 'Критичные', 'Итог', 'Порог']]).setFontWeight('bold');
  sh.getRange('E2').setValue(cfg.pass);
  sh.getRange('A2').setFormula('=ARRAYFORMULA(IF(' + q + '!A2:A="",,' + q + '!B2:B))');
  sh.getRange('B2').setFormula('=ARRAYFORMULA(IF(' + q + '!A2:A="",,IFERROR(VALUE(REGEXEXTRACT(TO_TEXT(' + q + '!C2:C),"^\\d+")),)))');
  const crit = DATA[key].filter(function (x) { return x.critical; });
  if (crit.length) {
    const prod = crit.map(function (x) {
      return '(' + col_(rs, x.title) + '="' + x.correct.replace(/"/g, '""') + '")';
    }).join('*');
    sh.getRange('C2').setFormula('=ARRAYFORMULA(IF(' + q + '!A2:A="",,IF(' + prod + ',"сданы","пересдача")))');
  } else {
    sh.getRange('C2').setFormula('=ARRAYFORMULA(IF(' + q + '!A2:A="",,"нет в этом тесте"))');
  }
  sh.getRange('D2').setFormula('=ARRAYFORMULA(IF(' + q + '!A2:A="",,IF((B2:B>=$E$2)*(C2:C<>"пересдача"),"сдал","пересдача")))');
  sh.setFrozenRows(1);
  sh.autoResizeColumns(1, 5);
}

function shuffle_(a) {
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    const t = a[i]; a[i] = a[j]; a[j] = t;
  }
  return a;
}
