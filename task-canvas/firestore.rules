rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function googleUser() {
   return request.auth != null && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider == 'google.com';
  }
  function admin() {return googleUser() && exists(/databases/$(database)/documents/taskCanvasAdmins/$(request.auth.token.email));}
  function owner(board) {return googleUser() && get(/databases/$(database)/documents/taskBoards/$(board)).data.ownerEmail == request.auth.token.email.lower();}
  function access(board) {
   let root = get(/databases/$(database)/documents/taskBoards/$(board)).data;
   return googleUser() && board == '1qh-pi5I76k8ssUc6DxjeytFDrAta1N4ZdmVjaUFCUYY' && root.ready == true && (root.ownerEmail == request.auth.token.email.lower() || request.auth.token.email.lower() in root.members);
  }
  function publicBoard(board) {
   return board == '1qh-pi5I76k8ssUc6DxjeytFDrAta1N4ZdmVjaUFCUYY' && get(/databases/$(database)/documents/taskBoardViews/$(board)).data.ready == true;
  }
  function publishedTask(board,key,data) {
   return data.archived ? !existsAfter(/databases/$(database)/documents/taskBoardViews/$(board)/tasks/$(key)) : getAfter(/databases/$(database)/documents/taskBoardViews/$(board)/tasks/$(key)).data == {'schema':1,'revision':data.revision,'task':data.task};
  }
  function actorOK(actor) {return actor.uid == request.auth.uid && actor.clientId is string && actor.clientId.size() <= 160 && actor.name is string && actor.name.size() <= 200;}
  function receipt(board,operation) {return getAfter(/databases/$(database)/documents/taskBoards/$(board)/operations/$(operation)).data;}
  function validTask(task) {
   return task.id is string && task.id.size()>0 && task.title is string && task.title.size()>0 && task.title.size()<=20000 && task.owner is string && task.due is string && task.status is string && task.positions is map;
  }
  function validEntry(data) {return data.schema==1 && data.revision is int && data.revision>0 && data.archived is bool && data.lifeVersion is string && data.lastOperationId is string && data.versions is map && validTask(data.task);}
  function versionAfter(board,key,revision) {return getAfter(/databases/$(database)/documents/taskBoards/$(board)/tasks/$(key)/versions/$(revision)).data;}
  function clientBridge(board) {
   let root = get(/databases/$(database)/documents/taskBoards/$(board)).data;
   return !('background' in root) || root.background.enabled != true;
  }
  function heldLease(board) {
   let lease = get(/databases/$(database)/documents/taskBoards/$(board)/meta/bridgeLease).data;
   return clientBridge(board) && lease.protocol==3 && lease.uid==request.auth.uid && lease.acquiredAt+duration.value(120,'s')>request.time;
  }
  match /taskCanvasAdmins/{email} {allow get: if googleUser() && email == request.auth.token.email;allow list, write: if false;}
  match /taskBoards/{board} {
   allow get: if access(board);
   allow list, create, delete: if false;
   allow update: if owner(board) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','accessRevision','lastAccessEvent']) && request.resource.data.members is list && request.resource.data.members.size()<=200 && request.resource.data.accessRevision==resource.data.accessRevision+1 && getAfter(/databases/$(database)/documents/taskBoards/$(board)/accessEvents/$(request.resource.data.lastAccessEvent)).data.before==resource.data.members && getAfter(/databases/$(database)/documents/taskBoards/$(board)/accessEvents/$(request.resource.data.lastAccessEvent)).data.after==request.resource.data.members;
   match /accessEvents/{event} {
    allow read: if owner(board);
    allow create: if owner(board) && actorOK(request.resource.data.actor) && request.resource.data.createdAt==request.time && request.resource.data.revision==getAfter(/databases/$(database)/documents/taskBoards/$(board)).data.accessRevision && event==getAfter(/databases/$(database)/documents/taskBoards/$(board)).data.lastAccessEvent && request.resource.data.after==getAfter(/databases/$(database)/documents/taskBoards/$(board)).data.members && request.resource.data.before==get(/databases/$(database)/documents/taskBoards/$(board)).data.members;
    allow update,delete: if false;
   }
   match /tasks/{key} {
    allow read: if access(board);
    allow create: if access(board) && validEntry(request.resource.data) && request.resource.data.revision==1 && actorOK(request.resource.data.actor) && request.resource.data.updatedAt==request.time && receipt(board,request.resource.data.lastOperationId).actor.uid==request.auth.uid && versionAfter(board,key,'1').after.task==request.resource.data.task && versionAfter(board,key,'1').before==null && publishedTask(board,key,request.resource.data);
    allow update: if access(board) && (
     (validEntry(request.resource.data) && request.resource.data.revision==resource.data.revision+1 && request.resource.data.task.id==resource.data.task.id && actorOK(request.resource.data.actor) && request.resource.data.updatedAt==request.time && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['task','revision','versions','archived','lifeVersion','lastOperationId','updatedAt','actor']) && receipt(board,request.resource.data.lastOperationId).actor.uid==request.auth.uid && versionAfter(board,key,string(request.resource.data.revision)).before.task==resource.data.task && versionAfter(board,key,string(request.resource.data.revision)).after.task==request.resource.data.task && publishedTask(board,key,request.resource.data))
     || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sheet','sheetAck']) && heldLease(board) && request.resource.data.sheet.observer==get(/databases/$(database)/documents/taskBoards/$(board)/meta/bridgeLease).data.holder)
    );
    allow delete: if false;
    match /versions/{revision} {
     allow read: if access(board);
     allow create: if access(board) && request.resource.data.revision==getAfter(/databases/$(database)/documents/taskBoards/$(board)/tasks/$(key)).data.revision && revision==string(request.resource.data.revision) && actorOK(request.resource.data.actor) && request.resource.data.createdAt==request.time && request.resource.data.after.task==getAfter(/databases/$(database)/documents/taskBoards/$(board)/tasks/$(key)).data.task && request.resource.data.operationId==getAfter(/databases/$(database)/documents/taskBoards/$(board)/tasks/$(key)).data.lastOperationId && receipt(board,request.resource.data.operationId).actor.uid==request.auth.uid && (!exists(/databases/$(database)/documents/taskBoards/$(board)/tasks/$(key)) ? request.resource.data.before==null : request.resource.data.before.task==get(/databases/$(database)/documents/taskBoards/$(board)/tasks/$(key)).data.task);
     allow update, delete: if false;
    }
   }
   match /operations/{operation} {
    allow get: if access(board);
    allow list, update, delete: if false;
    allow create: if access(board) && request.resource.data.schema==1 && request.resource.data.protocol==3 && actorOK(request.resource.data.actor) && request.resource.data.createdAt==request.time && request.resource.data.digest is string && request.resource.data.digest.matches('^[0-9a-f]{64}$') && request.resource.data.request is map && request.resource.data.result is map;
   }
   match /conflicts/{conflict} {
    allow read: if access(board);
    allow create: if access(board) && request.resource.data.status=='open' && request.resource.data.id==conflict && actorOK(request.resource.data.actor) && request.resource.data.createdAt==request.time && request.resource.data.group in ['task','title','unit','direction','description','comment','status','assignment','schedule','priority','context'] && receipt(board,request.resource.data.operationId).actor.uid==request.auth.uid && receipt(board,request.resource.data.operationId).taskId==request.resource.data.taskId;
    allow update: if access(board) && resource.data.status=='open' && request.resource.data.status=='resolved' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolution','resolvedAt']) && actorOK(request.resource.data.resolution.actor) && request.resource.data.resolvedAt==request.time && receipt(board,request.resource.data.resolution.operationId).actor.uid==request.auth.uid && request.resource.data.resolution.choice in ['local','remote'] && (resource.data.group=='task' ? request.resource.data.resolution.observedVersion==get(/databases/$(database)/documents/taskBoards/$(board)/tasks/$(resource.data.taskKey)).data.lastOperationId : request.resource.data.resolution.observedVersion==get(/databases/$(database)/documents/taskBoards/$(board)/tasks/$(resource.data.taskKey)).data.versions[resource.data.group]);
    allow delete: if false;
   }
   match /meta/{meta} {
    allow read: if access(board);
    allow create, update: if access(board) && (
     (meta=='bridgeLease' && clientBridge(board) && request.resource.data.protocol==3 && request.resource.data.uid==request.auth.uid && request.resource.data.holder is string && request.resource.data.acquiredAt==request.time && (!exists(/databases/$(database)/documents/taskBoards/$(board)/meta/bridgeLease) || !('protocol' in resource.data) || resource.data.protocol!=3 || resource.data.holder==request.resource.data.holder || resource.data.acquiredAt+duration.value(120,'s')<=request.time))
     || (meta=='source' && heldLease(board) && request.resource.data.status is string && request.resource.data.message is string && getAfter(/databases/$(database)/documents/taskBoardViews/$(board)/meta/source).data == {'status':request.resource.data.status,'checkedAt':request.resource.data.checkedAt})
     || (meta=='lanes' && request.resource.data.items is list && request.resource.data.revision==resource.data.revision+1 && receipt(board,request.resource.data.lastOperationId).actor.uid==request.auth.uid && getAfter(/databases/$(database)/documents/taskBoards/$(board)/laneVersions/$(string(request.resource.data.revision))).data.after==request.resource.data.items && getAfter(/databases/$(database)/documents/taskBoardViews/$(board)/meta/lanes).data == {'items':request.resource.data.items,'revision':request.resource.data.revision})
    );
    allow delete: if access(board) && meta=='bridgeLease' && resource.data.uid==request.auth.uid;
   }
   match /laneVersions/{revision} {
    allow read: if access(board);
    allow create: if access(board) && actorOK(request.resource.data.actor) && request.resource.data.createdAt==request.time && receipt(board,request.resource.data.operationId).actor.uid==request.auth.uid && request.resource.data.revision==getAfter(/databases/$(database)/documents/taskBoards/$(board)/meta/lanes).data.revision && request.resource.data.after==getAfter(/databases/$(database)/documents/taskBoards/$(board)/meta/lanes).data.items && request.resource.data.before==get(/databases/$(database)/documents/taskBoards/$(board)/meta/lanes).data.items;
    allow update, delete: if false;
   }
  }
  // Only this projection is public. Canonical records, archives, history,
  // conflict alternatives and operation receipts keep their editor permissions.
  match /taskBoardViews/{board} {
   allow get: if publicBoard(board) || access(board);
   allow list, write: if false;
   match /tasks/{key} {
    allow read: if publicBoard(board) || access(board);
    allow create, update: if access(board) && getAfter(/databases/$(database)/documents/taskBoards/$(board)/tasks/$(key)).data.archived == false && request.resource.data == {'schema':1,'revision':getAfter(/databases/$(database)/documents/taskBoards/$(board)/tasks/$(key)).data.revision,'task':getAfter(/databases/$(database)/documents/taskBoards/$(board)/tasks/$(key)).data.task};
    allow delete: if access(board) && getAfter(/databases/$(database)/documents/taskBoards/$(board)/tasks/$(key)).data.archived == true;
   }
   match /meta/{meta} {
    allow read: if meta in ['lanes','source'] && (publicBoard(board) || access(board));
    allow create, update: if access(board) && (
     (meta=='lanes' && request.resource.data == {'items':getAfter(/databases/$(database)/documents/taskBoards/$(board)/meta/lanes).data.items,'revision':getAfter(/databases/$(database)/documents/taskBoards/$(board)/meta/lanes).data.revision})
     || (meta=='source' && heldLease(board) && request.resource.data == {'status':getAfter(/databases/$(database)/documents/taskBoards/$(board)/meta/source).data.status,'checkedAt':getAfter(/databases/$(database)/documents/taskBoards/$(board)/meta/source).data.checkedAt})
    );
    allow delete: if false;
   }
  }

 }
}
