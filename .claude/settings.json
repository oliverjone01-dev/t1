{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(file:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(awk:*)",
      "Bash(jq:*)",
      "Bash(python3 -c:*)",
      "Bash(node -e:*)",
      "Bash(date:*)",
      "Bash(mkdir -p .claude/*)",
      "Bash(mkdir -p knowledge/*)",
      "Bash(mkdir -p traces/*)",
      "Bash(chmod +x .claude/hooks/*)",
      "Bash(.claude/skills/direct/scripts/yd-api.sh:*)",
      "Bash(bash .claude/skills/direct/scripts/yd-api.sh:*)",
      "Bash(.claude/skills/direct/scripts/yd-report.sh:*)",
      "Bash(bash .claude/skills/direct/scripts/yd-report.sh:*)",
      "WebFetch(domain:genglass.ru)",
      "WebFetch(domain:valonti.com)",
      "WebFetch(domain:gentero.ru)",
      "Bash(python3 schemas/validate.py:*)",
      "Bash(python3 schemas/smoke-test.py:*)",
      "Bash(node --check:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/approvals-state-monitor.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/data-guard.py\" stop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/p9-trigger-detector.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/context-meter.py\""
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/data-guard.py\" prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/anti-slop-checker.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/approvals-guard.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/feniks-write-scope.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/direct-write-gate.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/approvals-guard.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/deliver-gate.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/feniks-bash-scope.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/data-guard.py\" pre-bash"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/data-guard.py\" pre-edit"
          }
        ]
      },
      {
        "matcher": "mcp__github__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/data-guard.py\" pre-mcp-merge"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/subagent-trace.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/subagent-trace.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/data-guard.py\" session-start"
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "adapt": "name-only",
    "animate": "name-only",
    "arrange": "name-only",
    "audit": "name-only",
    "bolder": "name-only",
    "clarify": "name-only",
    "colorize": "name-only",
    "critique": "name-only",
    "delight": "name-only",
    "distill": "name-only",
    "extract": "name-only",
    "harden": "name-only",
    "normalize": "name-only",
    "onboard": "name-only",
    "optimize": "name-only",
    "overdrive": "name-only",
    "polish": "name-only",
    "quieter": "name-only",
    "typeset": "name-only",
    "teach-impeccable": "name-only",
    "remotion-best-practices": "name-only",
    "frontend-design-reference": "name-only"
  }
}
