Subject: [PATCH 1/3] =?UTF-8?q?infra-check:=20pipefail=20=D0=B8=20concurre?=
 =?UTF-8?q?ncy=20=D0=BF=D0=BE=20=D0=B3=D0=B8=D0=B3=D0=B8=D0=B5=D0=BD=D0=B5?=
 =?UTF-8?q?=20workflow=20(data-guard=20=D0=9A12)?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 .github/workflows/infra-check.yml | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/infra-check.yml b/.github/workflows/infra-check.yml
index 3d3d23a3..a50815d5 100644
--- a/.github/workflows/infra-check.yml
+++ b/.github/workflows/infra-check.yml
@@ -10,6 +10,10 @@ on:
     paths: [infra/vps/**, .github/workflows/infra-check.yml]
   workflow_dispatch:
 
+concurrency:
+  group: infra-check-${{ github.ref }}
+  cancel-in-progress: true
+
 permissions:
   contents: read
 
@@ -17,6 +21,9 @@ jobs:
   check:
     runs-on: ubuntu-latest
     timeout-minutes: 20
+    defaults:
+      run:
+        shell: bash
     steps:
       - uses: actions/checkout@v4
         with:
@@ -24,7 +31,7 @@ jobs:
       - name: shellcheck
         working-directory: infra/vps
         run: |
-          shellcheck --version | head -2
+          shellcheck --version
           shellcheck -S warning -x bin/* sbin/* lib/gg.sh site/build.sh bootstrap.sh test/smoke-local.sh site/steps/*.sh jobs/*.sh
       - name: smoke-local
         run: bash infra/vps/test/smoke-local.sh
