{
  "$schema": "Контур DS токены. Генерируется из tokens/tokens.css, руками не править.",
  "font": {
    "font-sans": "-apple-system, BlinkMacSystemFont, \"Golos Text\", \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "font-mono": "ui-monospace, \"SF Mono\", SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace",
    "fs-badge": "12px",
    "fs-micro": "11px",
    "fs-caption": "12px",
    "fs-small": "12.5px",
    "fs-body": "13px",
    "fs-base": "14px",
    "fs-h2": "16px",
    "fs-h1": "22px",
    "fs-h1-sm": "19px",
    "fs-hero": "clamp(24px, 20.7px + 0.85vw, 30px)",
    "lh-tight": "1.2",
    "lh-snug": "1.4",
    "lh-body": "1.55",
    "fw-regular": "400",
    "fw-medium": "500",
    "fw-semi": "600",
    "fw-bold": "700",
    "tracking-hero": "-0.025em",
    "tracking-h": "-0.015em",
    "tracking-num": "-0.01em",
    "tracking-caps": "0.04em"
  },
  "space": {
    "sp-0-5": "2px",
    "sp-1": "4px",
    "sp-1-5": "6px",
    "sp-2": "8px",
    "sp-2-5": "10px",
    "sp-3": "12px",
    "sp-3-5": "14px",
    "sp-4": "16px",
    "sp-5": "20px",
    "sp-6": "24px",
    "sp-8": "32px",
    "sp-10": "40px"
  },
  "radius": {
    "r-xs": "4px",
    "r-sm": "6px",
    "r-md": "8px",
    "r-lg": "12px",
    "r-full": "999px",
    "r-field": "var(--r-sm)",
    "r-box": "var(--r-lg)"
  },
  "motion": {
    "ease-std": "cubic-bezier(.4,0,.2,1)",
    "ease-out": "cubic-bezier(.2,.8,.2,1)",
    "ease-in": "cubic-bezier(.4,0,1,1)",
    "dur-fast": "160ms",
    "dur-base": "250ms",
    "dur-slow": "300ms",
    "dur-enter": "420ms",
    "dur-chart": "520ms"
  },
  "layout": {
    "sidebar-w": "248px",
    "sidebar-w-collapsed": "72px",
    "topbar-h": "58px",
    "content-pad": "24px",
    "content-pad-sm": "16px",
    "drawer-w": "560px",
    "content-max": "1480px",
    "tap": "44px",
    "tap-sm": "36px",
    "z-topbar": "20",
    "z-backdrop": "30",
    "z-sidebar": "40",
    "z-drawer": "50",
    "z-cmdk": "55",
    "z-toast": "60"
  },
  "density": {
    "comfortable": {
      "pad-box": "var(--sp-4)",
      "pad-box-lg": "var(--sp-5)",
      "gap-stack": "var(--sp-4)",
      "gap-stack-lg": "var(--sp-5)",
      "cell-y": "9px",
      "cell-x": "12px",
      "cell-head-y": "8px",
      "ctl-h": "32px",
      "ctl-h-sm": "26px",
      "field-h": "34px",
      "select-h": "30px",
      "nav-y": "7px"
    },
    "compact": {
      "pad-box": "var(--sp-3)",
      "pad-box-lg": "var(--sp-3-5)",
      "gap-stack": "var(--sp-3)",
      "gap-stack-lg": "var(--sp-3-5)",
      "cell-y": "5px",
      "cell-x": "10px",
      "cell-head-y": "6px",
      "ctl-h": "28px",
      "ctl-h-sm": "24px",
      "field-h": "30px",
      "select-h": "28px",
      "nav-y": "5px",
      "topbar-h": "52px",
      "content-pad": "20px",
      "fs-hero": "clamp(22px, 19.5px + 0.65vw, 26px)"
    }
  },
  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },
  "container": {
