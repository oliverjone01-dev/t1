{
  "name": "gengroup-analytics-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GENGLASS OZON analytics MVP - connector, store, period engine, dashboards",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "ping": "tsx src/scripts/ping.ts",
    "backfill": "tsx src/scripts/backfill.ts",
    "ingest": "tsx src/scripts/ingest.ts",
    "report": "tsx src/scripts/report.ts",
    "fetch:live": "tsx src/scripts/fetch-live.ts",
    "import:competitors": "tsx src/scripts/competitors/import-sheet.ts",
    "build:site": "tsx src/scripts/build-site.ts",
    "katya": "tsx src/scripts/build-katya.ts",
    "join:taxonomy": "tsx src/scripts/build-taxonomy-join.ts",
    "join:cogs": "tsx src/scripts/build-cogs-join.ts",
    "smoke": "tsx src/scripts/smoke.ts",
    "ads:reports": "tsx src/scripts/ozon/ad-reports.ts",
    "ads:daily": "tsx src/scripts/ozon/ads-daily.ts",
    "ads:attr": "tsx src/scripts/ozon/ad-attribution.ts",
    "ads:attrd": "tsx src/scripts/ozon/ad-attribution-daily.ts",
    "totals:daily": "tsx src/scripts/ozon/daily-totals.ts",
    "views:daily": "tsx src/scripts/ozon/sku-views.ts",
    "pnl:daily": "tsx src/scripts/ozon/pnl-daily.ts",
    "pnl:sku:daily": "tsx src/scripts/ozon/pnl-sku-daily.ts",
    "pnl:account:daily": "tsx src/scripts/ozon/pnl-account-daily.ts",
    "pnl:realization": "tsx src/scripts/ozon/pnl-realization.ts",
    "ads:sku:daily": "tsx src/scripts/ozon/ad-sku-daily.ts",
    "offer:sku": "tsx src/scripts/ozon/sku-offer.ts",
    "plan:from-sheet": "tsx src/scripts/plan-from-sheet.ts",
    "plan:fetch": "tsx src/scripts/plan-fetch.ts",
    "import:cards": "tsx src/scripts/ozon/import-card-groups.ts",
    "ym:ping": "tsx src/scripts/ym/ping.ts",
    "ym:orders": "tsx src/scripts/ym/orders.ts",
    "ym:catalog": "tsx src/scripts/ym/catalog.ts",
    "ym:derive": "tsx src/scripts/ym/derive.ts",
    "ym:realization": "tsx src/scripts/ym/reports.ts realization",
    "ym:netting": "tsx src/scripts/ym/reports.ts netting",
    "ym:shows": "tsx src/scripts/ym/reports.ts shows",
    "ym:reconcile": "tsx src/scripts/ym/reconcile.ts",
    "ym:join": "DATA_DIR=data-ym PLATFORM=ym tsx src/scripts/build-taxonomy-join.ts && DATA_DIR=data-ym PLATFORM=ym tsx src/scripts/build-cogs-join.ts",
    "ym:build": "DATA_DIR=data-ym OUT_DIR=public/market PLATFORM=ym tsx src/scripts/build-site.ts && DATA_DIR=data-ym OUT_DIR=public/market PLATFORM=ym tsx src/scripts/build-katya.ts",
    "ym:smoke": "OUT_DIR=public/market tsx src/scripts/smoke.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
