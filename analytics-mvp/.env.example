# Скопировать в .env и заполнить. .env в репозиторий НЕ попадает (см. .gitignore).
# После теста ключи ротировать - сейчас они также светятся в нодах n8n (аудит G4).

# OZON Seller API (api-seller.ozon.ru)
OZON_SELLER_CLIENT_ID=
OZON_SELLER_API_KEY=

# OZON Performance API (api-performance.ozon.ru) - OAuth client_credentials
OZON_PERF_CLIENT_ID=
OZON_PERF_CLIENT_SECRET=

# Пол данных аккаунта (раньше этой даты OZON отдаёт нули)
DATA_FLOOR=2026-02-01

# Путь к локальной БД
DB_PATH=data/analytics.db

# Яндекс Маркет Partner API (api.partner.market.yandex.ru), заголовок Api-Key. Только чтение.
# В GitHub Actions секрет называется YM_DASHBOARD_1 (YM_TOKEN - это Метрика, НЕ он).
YM_API_KEY=
# Бизнес-кабинеты (через запятую). По умолчанию 1023124 (GENGLASS, зеркала), 74986385 (GEN GROUP, мебель).
YM_BUSINESS_IDS=
# Явный список campaignId (пусто = все кампании ключа в кабинетах выше).
YM_CAMPAIGN_IDS=
