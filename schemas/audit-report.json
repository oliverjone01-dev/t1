{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gengroup.local/schemas/audit-report.json",
  "title": "FENIX Audit Report (Phoenix-Eval)",
  "description": "Output schema for any FENIX adversarial review. 25 checkpoints across 5 weighted criteria, weighted total, verdict, gaps and rework TZ. v3 (2026-09-06): optional anchor / probes / evidence_ledger / comprehension_gate / artifact_class; weighted_total обязан сходиться с Σ(score × weight) в пределах 0.05 (проверяет validate.py).",
  "type": "object",
  "required": [
    "agent",
    "skill",
    "task_id",
    "timestamp",
    "scores",
    "weighted_total",
    "verdict"
  ],
  "additionalProperties": false,
  "properties": {
    "agent": {
      "const": "feniks"
    },
    "skill": {
      "const": "phoenix-eval"
    },
    "task_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "deliverable_ref": {
      "type": "string"
    },
    "iteration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "checkpoints": {
      "type": "object",
      "description": "25 checkpoints, each 0/1/2",
      "patternProperties": {
        "^(accuracy|actionability|insight|brand|risk)_[0-9]+_[a-z0-9_]+$": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      },
      "additionalProperties": false
    },
    "scores": {
      "type": "object",
      "required": [
        "accuracy",
        "actionability",
        "insight",
        "brand_fit",
        "risk_awareness"
      ],
      "properties": {
        "accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "actionability": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "insight": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "brand_fit": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "risk_awareness": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "weighted_total": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "0.25*accuracy + 0.25*actionability + 0.20*insight + 0.15*brand_fit + 0.15*risk_awareness"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "go",
        "return",
        "veto"
      ],
      "description": "go: weighted >= 7.5 и нет понижающих правил; return: weighted >= 6.0 (в т.ч. >= 7.5 при поправке v3 с verdict_override_reason или FAIL пробы A/B7); veto: weighted < 6.0"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10
    },
    "rework_tz": {
      "type": "string",
      "description": "Concrete action items if verdict=return. Empty if go. Escalation note if veto."
    },
    "dispute_thread": {
      "type": "string",
      "description": "Path to dispute markdown if score <8 and author challenged"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "p9_triggers_fired": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "tokens_in": {
          "type": "integer"
        },
        "tokens_out": {
          "type": "integer"
        },
        "cost_usd": {
          "type": "number"
        },
        "wall_time_seconds": {
          "type": "number"
        }
      }
    },
    "artifact_class": {
      "type": "string",
      "enum": [
        "strategy",
        "content",
        "gate",
        "dashboard",
        "agent",
        "mixed"
      ],
      "description": "Phase 0 CLASSIFY (v3)"
    },
    "anchor": {
      "type": "string",
      "description": "Ближайший калибровочный якорь и почему выше/ниже (v3, обязателен по роли, схема не требует для обратной совместимости)"
    },
    "comprehension_gate": {
      "type": "object",
      "properties": {
        "applies": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        },
        "defects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "PARTIAL",
              "N/A"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "evidence_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gap",
          "evidence"
        ],
        "properties": {
          "gap": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "checkpoint": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          }
        }
      }
    },
    "primary_gap": {
      "type": "string"
    },
    "escalate_to": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "sources_of_truth": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict_override_reason": {
      "type": "string",
      "description": "Почему verdict ниже, чем даёт weighted_total (v3): FAIL пробы класса A/B7, класс без проб, self-claimed score. Обязателен при return с weighted_total >= 7.5 (проверяет validate.py)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "veto"
          }
        }
      },
      "then": {
        "properties": {
          "weighted_total": {
            "exclusiveMaximum": 6.0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "return"
          }
        }
      },
      "then": {
        "properties": {
          "weighted_total": {
            "minimum": 6.0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "go"
          }
        }
      },
      "then": {
        "properties": {
          "weighted_total": {
            "minimum": 7.5
          }
        }
      }
    }
  ]
}
