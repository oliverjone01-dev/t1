# Скопировать в yandex-direct/.env и заполнить. Файл .env в git НЕ попадает (см. .gitignore).
# В Claude Code on the web те же переменные дублируются в настройках окружения
# (Environment variables) - тогда локальный .env не нужен.
# Токены держать в секрете, на GitHub не коммитить. При утечке - ротировать.

# OAuth-токен приложения Яндекс.Директ (api.direct.yandex.com)
YANDEX_DIRECT_TOKEN=

# Логин рекламного кабинета (нужен для агентских аккаунтов; для одиночного - можно пусто)
YANDEX_DIRECT_LOGIN=

# OAuth-токен Яндекс.Метрики (api-metrika.yandex.net) - для данных по конверсиям
YANDEX_METRIKA_TOKEN=

# ID счётчика Метрики (не секрет, идентификатор) - для привязки конверсий к кабинету.
# Рабочий счётчик GENGLASS: 104369223 ("Новый GenGlass", genglass.ru, связка с Директом + ecommerce).
YANDEX_METRIKA_COUNTER=104369223
