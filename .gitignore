# Python bytecode cache
__pycache__/
*.pyc
*.pyo

# Персональные override Claude Code (пин модели и т.п.), не коммитим
.claude/settings.local.json

# Дизайн-системы, сгенерированные ui-ux-pro-max --persist
design-system/

# Секреты (токены Директ/Метрика и любые .env) - НИКОГДА не коммитим.
# В git идёт только .env.example (шаблон с пустыми значениями).
.env
.env.local
**/.env
**/.env.local
.secrets/
**/.secrets/
yandex-direct.json

# HITL-апрувы мутаций (Protocol 6) - действуют один день, в git не попадают
.claude/approvals/
