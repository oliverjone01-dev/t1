# Шаблон /etc/gg/secrets.env (НЕ коммитить заполненным!). Права: root:gg 0640.
# Имена совпадают с GitHub Secrets, поэтому скрипты работают без правок.
# Значения из GitHub прочитать нельзя: берутся из первоисточника или перевыпускаются.
# Заполнять по мере переноса задач (INVENTORY.md), лишнего не держать.

# --- Алерты сервера (новое): бот и чат, куда падают сообщения об ошибках задач/выката ---
GG_ALERT_BOT_TOKEN=
GG_ALERT_CHAT_ID=

# --- Bitrix24 (РОП, офис, производство, экономика, диалоги, ПТО) ---
B24_WEBHOOK_URL=

# --- OZON ---
OZON_SELLER_CLIENT_ID=
OZON_SELLER_API_KEY=
OZON_PERF_CLIENT_ID=
OZON_PERF_SECRET=

# --- Яндекс: Директ, Метрика, Маркет, Wordstat/Поиск ---
YANDEX_DIRECT_LOGIN=
YANDEX_DIRECT_TOKEN=
YANDEX_METRIKA_TOKEN=
YANDEX_METRIKA_COUNTER=104369223
YM_DASHBOARD_1=
YM_DASHBOARD_ZERKALA_2=
YM_BUSINESS_IDS=
YM_CAMPAIGN_IDS=
YANDEX_FOLDER_ID=
YANDEX_OAUTH_TOKEN=
YANDEX_SEARCH_API_KEY=

# --- Keys.so ---
KEYSO_TOKEN=

# --- Точка банк ---
TOCHKA_CLIENT_ID=
TOCHKA_CLIENT_SECRET=
TOCHKA_CUSTOMER_CODE=
TOCHKA_REFRESH_TOKEN=
TOCHKA_ACCOUNT_FILTER=

# --- Telegram-боты отчётов ---
# Дайджест РОП (rop-digest-*): пока пусто - шлёт ботом алертов в группу алертов (параллельный прогон).
# В день переключения: токен бота РОП (@BotFather -> /mybots -> API Token) и чат отдела продаж.
ROPCACHE_BOT_TOKEN=
GG_DIGEST_CHAT_ID=
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_THREAD_ID=
