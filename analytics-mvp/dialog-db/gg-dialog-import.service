[Unit]
Description=Import validated dialogue snapshot into PostgreSQL
After=postgresql.service
[Service]
Type=oneshot
User=gg
Group=gg
ExecStart=/usr/bin/python3 /srv/gg/dialog-db/current/server.py import /srv/gg/www/current/dialog/index.html
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
